generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

model User {
  id            Int         @id @default(autoincrement())
  walletAddress String      @unique
  nonce         String
  createdAt     DateTime    @default(now())
  
  // 암호화된 지갑 키 (보안 필드)
  encryptedPrivateKey String?
  iv                  String?
  authTag             String?

  config        UserConfig? 
}

model UserConfig {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  user                User     @relation(fields: [userId], references: [id])
  
  topN                Int      @default(3)
  maxCopyAttempts     Int      @default(10)
  sortBy              String   @default("score")
  requireInRange      Boolean  @default(true)
  minAprPercent       Float    @default(20.0)
  
  copyAmountUsd       Float    @default(3.0)
  dryRun              Boolean  @default(false)
  intervalMs          Int      @default(1800000)
  
  pools               Json     @default("[]") 
  autoRechargeTokens  Json     @default("[]") 
}
  